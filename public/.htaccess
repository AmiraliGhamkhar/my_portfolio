Options -Indexes -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect to the canonical HTTPS host without relying on a Node server.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.amiralighamkhar\.ir$ [NC]
  RewriteRule ^ https://amiralighamkhar.ir%{REQUEST_URI} [R=301,L]

  # API and uploaded media have their own access rules.
  RewriteRule ^(?:api|uploads)(?:/|$) - [L]

  # Serve generated static routes and assets first.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route new project slugs and other deep links to their locale's prerendered shell.
  RewriteRule ^fa(?:/.*)?$ /fa/index.html [L]
  RewriteRule ^en(?:/.*)?$ /en/index.html [L]
  RewriteRule ^admin(?:/.*)?$ /admin/index.html [L]

  # Unknown top-level paths resolve to the Persian default experience.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
</IfModule>

<FilesMatch "^(?:\.env|\.git|composer\.(?:json|lock)|package(?:-lock)?\.json|tsconfig\.json|.*\.(?:sql|log|ini|dist))$">
  Require all denied
</FilesMatch>
